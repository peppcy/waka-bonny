DATABASE_URL=postgres://user:password@host:5432/waka
NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
# Comma-separated origins allowed to call the API (e.g. your Vercel frontend). Leave empty if the API also serves the frontend.
CORS_ORIGINS=
# First admin account, created by `npm run seed`
ADMIN_NAME=Waka Admin
ADMIN_PHONE=08000000000
ADMIN_PIN=123456
# Import neighbourhoods from Hale when running `npm run seed` (leave empty to use config/neighbourhoods.js)
HALE_API_URL=
HALE_CITY=Bonny

# Public address of the app (used in SMS tracking links and Paystack return links)
APP_URL=https://waka-bonny-production.up.railway.app

# ---- SMS (sign-up codes, PIN reset, parcel delivery codes) ----
# termii | africastalking | console (console = codes shown in logs/app for testing only; never use in production)
SMS_PROVIDER=console
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_CHANNEL=dnd
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# ---- Paystack ----
PAYSTACK_SECRET_KEY=

# Optional: the domain used to build each customer's Paystack email (<phone>@domain).
# Only change this if Hale and Waka Bonny share one Paystack business and you want them told apart.
PAYSTACK_EMAIL_DOMAIN=wakabonny.ng

# ---- Maps ----
# Leave empty to use the free OpenStreetMap / Esri layers.
# With a MapTiler key the app uses MapTiler and falls back to the free maps if its tiles fail.
# Restrict the key to your own domain in the MapTiler dashboard: it is visible in the browser.
MAPTILER_KEY=
# Only needed if the default map names are not on your MapTiler plan — paste the exact tile URLs
# shown on your MapTiler maps page (the key is added automatically if the URL has none).
MAPTILER_STREETS_URL=
MAPTILER_SATELLITE_URL=

# How many months location data is kept before the daily clean-up deletes it (default 12).
# This must match what the Privacy Policy says.
RETENTION_MONTHS=12
